# Optional for student photo display and upload. Copy to api/.env.
# Obtain development storage credentials from the project owner privately.
OVH_S3_ENDPOINT=https://s3.bhs.io.cloud.ovh.net
OVH_S3_REGION=bhs
OVH_S3_BUCKET=YOUR_DEVELOPMENT_BUCKET
OVH_S3_ACCESS_KEY=YOUR_ACCESS_KEY
OVH_S3_SECRET_KEY=YOUR_SECRET_KEY
